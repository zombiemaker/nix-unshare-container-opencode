{
	"$schema": "https://opencode.ai/config.json",
	"disableBuiltInProviders": true,
	"disabled_providers": [],
	"enabled_providers": [
		"local.strata",
		"local.llama.cpp",
		"local.ollama"
	],
	"provider": {
		"local.strata": {
			"name": "local-strata",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://192.168.1.90:9943/v1"
			},
			"models": {
				"qwen-3.8.fn": {
					"modelID": "qwen-3.8.fn",
					"name": "qwen3.8-flash-next-iq3_s",
					"limit": {
						"context": 262144,
						"output": 32768
					}
				},
				"p1_m2_id": {
					"modelID": "p1_m2_id",
					"name": "p1_m2_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				},
				"p1_m3_id": {
					"modelID": "p1_m3_id",
					"name": "p1_m3_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				}
			}
		},
		"local.llama.cpp": {
			"name": "local-llama-cpp",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://192.168.1.90:9941/v1"
			},
			"models": {
				"qwen-3-embedding-0.6b": {
					"modelID": "qwen-3-embedding-0.6b",
					"name": "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				},
				"p2_m2_id": {
					"modelID": "p2_m2_id",
					"name": "p2_m2_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				},
				"p2_m3_id": {
					"modelID": "p2_m3_id",
					"name": "p2_m3_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				}
			}
		},
		"local.ollama": {
			"name": "local-ollama",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://192.168.1.108:11434/v1"
			},
			"models": {
				"qwen-2.5-coder-7b": {
					"modelID": "qwen-2.5-coder-7b",
					"name": "qwen-2.5-coder:7b",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				},
				"p3_m2_id": {
					"modelID": "p3_m2_id",
					"name": "p3_m2_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				},
				"p3_m3_id": {
					"modelID": "p3_m3_id",
					"name": "p3_m3_name",
					"limit": {
						"context": 32768,
						"output": 16384
					}
				}
			}
		}
	},
	"server": {
		"port": 9000,
		"hostname": "0.0.0.0",
		"mdns": true,
		"mdnsDomain": "opencode.local",
		"cors": [ "http://localhost" ]
	},
	"compaction": {
		"auto": true,
		"keep": { "tokens": 24000 },
		"buffer": 16384,
	},
}
