{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    // Sets default integrated terminal working directory
    "terminal.integrated.cwd": "",

    // Use inside custom terminal profiles
    "terminal.integrated.profiles.linux": {
        "Workspace GNU Bash": {
            "path": "/usr/bin/env",
            "args": [
                "bash",
                "-c",
                "CODE_DIR=$(dirname \"$(find \"$(dirname \"$VSCODE_GIT_ASKPASS_NODE\")\" -type f -name \"code\" 2>/dev/null | head -n 1)\"); [ -n \"$CODE_DIR\" ] && export PATH=\"$PATH:$CODE_DIR\"; exec bash"
            ],
            "icon": "terminal-bash",
            "env": {
                "WORKSPACE_ROOT": "${workspaceFolder}",
                "GOPATH": "${workspaceFolder}/.apps/go",
                "GOBIN": "${workspaceFolder}/.apps/go/bin",
                "GOTMPDIR": "${workspaceFolder}/.temp",
                "TEMP": "${workspaceFolder}/.temp",
                "TEMPDIR": "${workspaceFolder}/.temp",
                "TMP": "${workspaceFolder}/.temp",
                "TMPDIR": "${workspaceFolder}/.temp",
                "PATH": "${workspaceFolder}/.apps/bin:${workspaceFolder}/.apps/go/bin:${workspaceFolder}/process/code/gnu_bash:${workspaceFolder}/process/code/powershell/scripts:${workspaceFolder}/product/code/powershell/scripts:${env:PATH}",
            }
        },
        "Workspace PowerShell": {
            
            "path": "/usr/bin/env",
            "args": [
                "pwsh",
                "-NoProfile",
                "-NoExit",
                "-Command",
                "$env:PATH += ':' + $($env:VSCODE_GIT_ASKPASS_NODE | Split-Path -Parent | Get-ChildItem -Filter \"code\" -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1 | Split-Path -Parent)"
            ],
            "icon": "terminal-powershell",
            "env": {
                "WORKSPACE_ROOT": "${workspaceFolder}",
                "GOPATH": "${workspaceFolder}/.apps/go",
                "GOBIN": "${workspaceFolder}/.apps/go/bin",
                "GOTMPDIR": "${workspaceFolder}/.temp",
                "PSModulePath": "${workspaceFolder}/process/code/powershell/modules:${workspaceFolder}/product/code/powershell/modules:${env:PSModulePath}",
                "TEMP": "${workspaceFolder}/.temp",
                "TEMPDIR": "${workspaceFolder}/.temp",
                "TMP": "${workspaceFolder}/.temp",
                "TMPDIR": "${workspaceFolder}/.temp",
                "PATH": "${workspaceFolder}/.apps/bin:${workspaceFolder}/.apps/go/bin:${workspaceFolder}/process/code/gnu_bash:${workspaceFolder}/process/code/powershell/scripts:${env:PATH}",
            }
        },
    },
    "terminal.integrated.automationProfile.linux": {
        "path": "/usr/bin/env",
        "args": [
            "bash",
        ],
        "env": {
            "WORKSPACE_ROOT": "${workspaceFolder}",
            "GOPATH": "${workspaceFolder}/.apps/go",
            "GOBIN": "${workspaceFolder}/.apps/go/bin",
            "GOTMPDIR": "${workspaceFolder}/.temp",
            "TEMP": "${workspaceFolder}/.temp",
            "TEMPDIR": "${workspaceFolder}/.temp",
            "TMP": "${workspaceFolder}/.temp",
            "TMPDIR": "${workspaceFolder}/.temp",},
            "PATH": "${workspaceFolder}/.apps/bin:${workspaceFolder}/.apps/go/bin:${env:PATH}",
    },
    "terminal.integrated.defaultProfile.linux": "Workspace GNU Bash",
    "terminal.integrated.letterSpacing": 1,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font','Cascadia Mono','CommitMono Nerd Font Mono', 'Apple Color Emoji', 'Segoe UI Emoji', monospace",
    "go.gopath": "",
    "go.inferGopath": true,
    "go.testEnvVars": {},
    "gopls": {
        "build.env": {},
        "build.directoryFilters": [
            "-/.temp",
            "+/product/code/go/eaets.mui.api_server/production"
        ],
        "build.expandWorkspaceToModule": true
    },
    "shfmt.executablePath": "",
    "shellformat.flag": null
}